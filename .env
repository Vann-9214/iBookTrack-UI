# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Your requested DB)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=ibooktrack_db

# Client Backend Authority (The "No-Limit" Access)
CLIENT_API_BASE_URL=https://api.client-backend.com
CLIENT_API_KEY=your_secret_client_key_here

# Security (For your Figma Login/Register flow)
JWT_SECRET=a_very_long_random_string_for_auth

# Tooling
WINDSURF_AI_LICENSE_KEY=your_premium_key_here
