# Server Configuration
PORT=
NODE_ENV=

# Set to "true" ONLY in local development to allow private-LAN and
# *.trycloudflare.com origins through CORS. Leave blank/unset everywhere else.
# Has no effect when NODE_ENV=production.
ALLOW_DEV_ORIGINS=

# Security (For your Figma Login/Register flow)
JWT_SECRET=

# PostgreSQL Database (Neon)
DATABASE_URL=

# iLMS API Integration (Client's Book System)
ILMS_BASE_MUSTANG_URL=
ILMS_BASE_JAGUAR_URL=
ILMS_AUTH_TOKEN=
ILMS_MUSTANG_URL=
ILMS_JAGUAR_URL=

# SIMFLEX/ScanManager API Integration (Client's Book System)
SIMFLEX_API_URL=
SIMFLEX_API_KEY=
SIMFLEX_MUSTANG_CONFIG=
SIMFLEX_JAGUAR_CONFIG=

# Innodata SSO (Unified Workflow OAuth2)
OAUTH_AUTHORIZE_URL=
OAUTH_TOKEN_URL=
OAUTH_USERINFO_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=